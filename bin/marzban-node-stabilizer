#!/usr/bin/env bash
set -euo pipefail

APP_NAME="marzban-node-stabilizer"

CONTAINER_NAME="${CONTAINER_NAME:-marzban-node}"
SERVICE_NAME="${SERVICE_NAME:-marzban-node}"
COMPOSE_FILE="${COMPOSE_FILE:-/opt/marzban-node/docker-compose.yml}"

PATCH_DIR="${PATCH_DIR:-/opt/marzban-node-patches}"
PATCH_FILE="$PATCH_DIR/rest_service.py"
ORIGINAL_FILE="$PATCH_DIR/rest_service.py.original_backup"

TIMEOUT_SECONDS="${TIMEOUT_SECONDS:-45}"
RESTART_GRACE_SECONDS="${RESTART_GRACE_SECONDS:-60}"
STARTUP_WAIT_SECONDS="${STARTUP_WAIT_SECONDS:-70}"
START_WAIT_SECONDS="${START_WAIT_SECONDS:-10}"

info() {
  echo "[INFO] $*"
}

warn() {
  echo "[WARN] $*" >&2
}

error() {
  echo "[ERROR] $*" >&2
  exit 1
}

usage() {
  cat <<USAGE
${APP_NAME}

Usage:
  sudo ${APP_NAME} apply
  sudo ${APP_NAME} status
  sudo ${APP_NAME} restore
  sudo ${APP_NAME} help

Environment variables:
  CONTAINER_NAME          Default: marzban-node
  SERVICE_NAME            Default: marzban-node
  COMPOSE_FILE            Default: /opt/marzban-node/docker-compose.yml
  PATCH_DIR               Default: /opt/marzban-node-patches
  TIMEOUT_SECONDS         Default: 45
  RESTART_GRACE_SECONDS   Default: 60
  STARTUP_WAIT_SECONDS    Default: 70
  START_WAIT_SECONDS      Default: 10
USAGE
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    error "Run this command as root."
  fi
}

check_os() {
  if [ ! -f /etc/os-release ]; then
    error "Cannot detect OS. Debian/Ubuntu is required."
  fi

  . /etc/os-release
  OS_MATCH=" ${ID:-} ${ID_LIKE:-} "

  case "$OS_MATCH" in
    *" debian "*|*" ubuntu "*) ;;
    *) error "Unsupported OS: ${PRETTY_NAME:-unknown}. Debian/Ubuntu is required." ;;
  esac
}

check_requirements() {
  command -v python3 >/dev/null 2>&1 || error "python3 is required."
  command -v docker >/dev/null 2>&1 || error "docker is required."

  if ! docker info >/dev/null 2>&1; then
    error "Docker is not running or current user cannot access Docker."
  fi

  if ! docker compose version >/dev/null 2>&1 && ! command -v docker-compose >/dev/null 2>&1; then
    error "docker compose or docker-compose is required."
  fi

  if [ ! -f "$COMPOSE_FILE" ]; then
    error "Compose file not found: $COMPOSE_FILE"
  fi
}

container_is_running() {
  docker ps --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"
}

compose_up() {
  local mode="${1:-normal}"
  cd "$(dirname "$COMPOSE_FILE")"

  if docker compose version >/dev/null 2>&1; then
    if [ "$mode" = "force" ]; then
      docker compose up -d --force-recreate "$SERVICE_NAME" || docker compose up -d --force-recreate
    else
      docker compose up -d "$SERVICE_NAME" || docker compose up -d
    fi
  elif command -v docker-compose >/dev/null 2>&1; then
    if [ "$mode" = "force" ]; then
      docker-compose up -d --force-recreate "$SERVICE_NAME" || docker-compose up -d --force-recreate
    else
      docker-compose up -d "$SERVICE_NAME" || docker-compose up -d
    fi
  else
    error "Neither docker compose nor docker-compose found."
  fi
}

backup_compose() {
  info "Backing up compose file..."
  cp "$COMPOSE_FILE" "$COMPOSE_FILE.bak.$(date +%Y%m%d-%H%M%S)"
}

compose_has_rest_service_mount() {
  grep -q "/code/rest_service.py" "$COMPOSE_FILE"
}

host_patch_file_is_valid() {
  [ -f "$PATCH_FILE" ] || return 1
  python3 -m py_compile "$PATCH_FILE" >/dev/null 2>&1
}

remove_bind_mount() {
  info "Removing rest_service.py bind mount from docker-compose.yml if present..."

  COMPOSE_FILE="$COMPOSE_FILE" python3 - <<'PY'
import os
from pathlib import Path

compose_path = Path(os.environ["COMPOSE_FILE"])
lines = compose_path.read_text().splitlines()

out = []
removed = False

for line in lines:
    if "/code/rest_service.py" in line:
        removed = True
        continue
    out.append(line)

clean = []
i = 0

while i < len(out):
    line = out[i]

    if line.strip() == "volumes:":
        indent = len(line) - len(line.lstrip())
        j = i + 1
        has_item = False

        while j < len(out):
            next_line = out[j]
            if next_line.strip() and (len(next_line) - len(next_line.lstrip())) <= indent:
                break
            if next_line.strip().startswith("- "):
                has_item = True
            j += 1

        if not has_item:
            removed = True
            i = j
            continue

    clean.append(line)
    i += 1

compose_path.write_text("\n".join(clean) + "\n")

if removed:
    print("[OK] bind mount removed")
else:
    print("[OK] bind mount was not present")
PY
}

add_bind_mount() {
  info "Ensuring rest_service.py bind mount exists in docker-compose.yml..."

  COMPOSE_FILE="$COMPOSE_FILE" PATCH_FILE="$PATCH_FILE" SERVICE_NAME="$SERVICE_NAME" python3 - <<'PY'
import os
from pathlib import Path

compose_path = Path(os.environ["COMPOSE_FILE"])
patch_file = os.environ["PATCH_FILE"]
service_name = os.environ["SERVICE_NAME"]
mount_line = f"- {patch_file}:/code/rest_service.py:ro"

lines = compose_path.read_text().splitlines()
lines = [line for line in lines if "/code/rest_service.py" not in line]

service_start = None
service_indent = None

for i, line in enumerate(lines):
    if line.strip() == f"{service_name}:":
        service_start = i
        service_indent = len(line) - len(line.lstrip())
        break

if service_start is None:
    raise SystemExit(f"[ERROR] Could not find service named {service_name} in compose file")

service_end = len(lines)

for i in range(service_start + 1, len(lines)):
    line = lines[i]
    if line.strip() and (len(line) - len(line.lstrip())) <= service_indent:
        service_end = i
        break

block = lines[service_start:service_end]
vol_idx = None

for idx, line in enumerate(block):
    if line.strip() == "volumes:":
        vol_idx = service_start + idx
        break

if vol_idx is not None:
    vol_indent = len(lines[vol_idx]) - len(lines[vol_idx].lstrip())
    item_indent = " " * (vol_indent + 2)
    insert_at = vol_idx + 1

    while insert_at < service_end:
        line = lines[insert_at]
        if line.strip() and (len(line) - len(line.lstrip())) <= vol_indent:
            break
        insert_at += 1

    lines.insert(insert_at, item_indent + mount_line)
else:
    key_indent = " " * (service_indent + 2)
    item_indent = " " * (service_indent + 4)
    insert_at = service_end
    lines.insert(insert_at, key_indent + "volumes:")
    lines.insert(insert_at + 1, item_indent + mount_line)

compose_path.write_text("\n".join(lines) + "\n")
print("[OK] bind mount configured")
PY
}

patch_file_python() {
  local target_file="$1"

  TARGET_FILE="$target_file" \
  TIMEOUT_SECONDS="$TIMEOUT_SECONDS" \
  RESTART_GRACE_SECONDS="$RESTART_GRACE_SECONDS" \
  python3 - <<'PY'
import os
import re
from pathlib import Path
import py_compile

target = Path(os.environ["TARGET_FILE"])
timeout = int(os.environ.get("TIMEOUT_SECONDS", "45"))
grace = int(os.environ.get("RESTART_GRACE_SECONDS", "60"))

if not target.exists():
    raise SystemExit(f"[ERROR] File not found: {target}")

s = target.read_text()
backup = target.with_name(target.name + ".original_backup")

if not backup.exists():
    backup.write_text(s)

s = re.sub(r"end_time\s*=\s*start_time\s*\+\s*\d+", f"end_time = start_time + {timeout}", s)

if "self.last_start_ts" not in s:
    s = s.replace(
        "        self.config = None\n",
        "        self.config = None\n        self.last_start_ts = 0\n",
        1,
    )

if "self.core.start(config)\n                self.last_start_ts = time.time()" not in s:
    s = s.replace(
        "                self.core.start(config)\n",
        "                self.core.start(config)\n                self.last_start_ts = time.time()\n",
        1,
    )

s = re.sub(r"time\.time\(\)\s*-\s*self\.last_start_ts\s*<\s*\d+", f"time.time() - self.last_start_ts < {grace}", s)

if "Ignoring restart during Xray startup grace period" not in s:
    needle = (
        "        try:\n"
        "            with self.core.get_logs() as logs:\n"
        "                self.core.restart(config)\n"
    )
    repl = (
        f"        if self.core.started and time.time() - self.last_start_ts < {grace}:\n"
        "            logger.warning(\"Ignoring restart during Xray startup grace period.\")\n"
        "            return self.response()\n"
        "        try:\n"
        "            with self.core.get_logs() as logs:\n"
        "                self.core.restart(config)\n"
        "                self.last_start_ts = time.time()\n"
    )
    if needle not in s:
        raise SystemExit("[ERROR] Could not find restart block. Marzban Node code may have changed.")
    s = s.replace(needle, repl, 1)

target.write_text(s)
py_compile.compile(str(target), doraise=True)
print(f"[OK] patched: {target}")
PY
}

patch_container_file() {
  info "Patching /code/rest_service.py inside container..."

  docker exec -i \
    -e TIMEOUT_SECONDS="$TIMEOUT_SECONDS" \
    -e RESTART_GRACE_SECONDS="$RESTART_GRACE_SECONDS" \
    "$CONTAINER_NAME" \
    python3 - <<'PY'
import os
import re
from pathlib import Path
import py_compile

timeout = int(os.environ.get("TIMEOUT_SECONDS", "45"))
grace = int(os.environ.get("RESTART_GRACE_SECONDS", "60"))
target = Path("/code/rest_service.py")

if not target.exists():
    raise SystemExit("[ERROR] /code/rest_service.py not found inside container")

s = target.read_text()
backup = Path("/code/rest_service.py.original_backup")

if not backup.exists():
    backup.write_text(s)

s = re.sub(r"end_time\s*=\s*start_time\s*\+\s*\d+", f"end_time = start_time + {timeout}", s)

if "self.last_start_ts" not in s:
    s = s.replace(
        "        self.config = None\n",
        "        self.config = None\n        self.last_start_ts = 0\n",
        1,
    )

if "self.core.start(config)\n                self.last_start_ts = time.time()" not in s:
    s = s.replace(
        "                self.core.start(config)\n",
        "                self.core.start(config)\n                self.last_start_ts = time.time()\n",
        1,
    )

s = re.sub(r"time\.time\(\)\s*-\s*self\.last_start_ts\s*<\s*\d+", f"time.time() - self.last_start_ts < {grace}", s)

if "Ignoring restart during Xray startup grace period" not in s:
    needle = (
        "        try:\n"
        "            with self.core.get_logs() as logs:\n"
        "                self.core.restart(config)\n"
    )
    repl = (
        f"        if self.core.started and time.time() - self.last_start_ts < {grace}:\n"
        "            logger.warning(\"Ignoring restart during Xray startup grace period.\")\n"
        "            return self.response()\n"
        "        try:\n"
        "            with self.core.get_logs() as logs:\n"
        "                self.core.restart(config)\n"
        "                self.last_start_ts = time.time()\n"
    )
    if needle not in s:
        raise SystemExit("[ERROR] Could not find restart block. Marzban Node code may have changed.")
    s = s.replace(needle, repl, 1)

target.write_text(s)
py_compile.compile(str(target), doraise=True)
print("[OK] patched: /code/rest_service.py")
PY
}

container_file_is_writable() {
  docker exec "$CONTAINER_NAME" sh -c 'test -w /code/rest_service.py' >/dev/null 2>&1
}

copy_patch_to_host() {
  mkdir -p "$PATCH_DIR"

  info "Copying patched file to host: $PATCH_FILE"
  docker cp "$CONTAINER_NAME:/code/rest_service.py" "$PATCH_FILE"
  chmod 644 "$PATCH_FILE"

  info "Copying original backup to host: $ORIGINAL_FILE"
  if docker exec "$CONTAINER_NAME" test -f /code/rest_service.py.original_backup; then
    docker cp "$CONTAINER_NAME:/code/rest_service.py.original_backup" "$ORIGINAL_FILE"
    chmod 644 "$ORIGINAL_FILE"
  else
    warn "Original backup was not found inside container. Continuing anyway."
  fi
}

wait_for_container() {
  local waited=0
  while [ "$waited" -lt "$START_WAIT_SECONDS" ]; do
    if container_is_running; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

ensure_container_running_or_recover() {
  if container_is_running; then
    return 0
  fi

  warn "Container is not running: $CONTAINER_NAME"
  info "Trying to start it with Docker Compose..."

  if compose_up normal && wait_for_container; then
    return 0
  fi

  if compose_has_rest_service_mount && ! host_patch_file_is_valid; then
    warn "Container did not start and current rest_service.py mount is missing or invalid."
    warn "Recovering by removing the bind mount and starting the original container..."
    backup_compose
    remove_bind_mount
    compose_up force
    if wait_for_container; then
      return 0
    fi
  fi

  error "Container is not running: $CONTAINER_NAME. Start Marzban Node first, then run this command."
}

recover_from_readonly_or_bad_mount() {
  warn "Container file is read-only and no valid host patch file is available."
  warn "Recovering by removing the bind mount, recreating the container, and patching a fresh file..."
  backup_compose
  remove_bind_mount
  compose_up force
  wait_for_container || error "Container did not start after removing the bind mount."
}

apply_patch() {
  require_root
  check_os
  check_requirements
  mkdir -p "$PATCH_DIR"

  echo "[INFO] ${APP_NAME}"
  echo "[INFO] container: $CONTAINER_NAME"
  echo "[INFO] service:   $SERVICE_NAME"
  echo "[INFO] compose:   $COMPOSE_FILE"
  echo "[INFO] patch dir: $PATCH_DIR"
  echo "[INFO] timeout:   $TIMEOUT_SECONDS seconds"
  echo "[INFO] grace:     $RESTART_GRACE_SECONDS seconds"
  echo

  ensure_container_running_or_recover

  if compose_has_rest_service_mount; then
    info "Existing rest_service.py bind mount detected."

    if host_patch_file_is_valid; then
      info "Host patch file exists and is valid. Patching host file directly..."
      patch_file_python "$PATCH_FILE"
      backup_compose
      add_bind_mount
      info "Recreating container so the patched bind mount is active..."
      compose_up force
    else
      recover_from_readonly_or_bad_mount
      patch_container_file
      copy_patch_to_host
      backup_compose
      add_bind_mount
      info "Recreating container so bind mount becomes active..."
      compose_up force
    fi
  else
    if container_file_is_writable; then
      patch_container_file
      copy_patch_to_host
    else
      warn "Container file is not writable. Falling back to host patch flow..."
      docker cp "$CONTAINER_NAME:/code/rest_service.py" "$PATCH_FILE"
      chmod 644 "$PATCH_FILE"
      patch_file_python "$PATCH_FILE"
    fi

    backup_compose
    add_bind_mount
    info "Recreating container so bind mount becomes active..."
    compose_up force
  fi

  echo
  info "Waiting ${STARTUP_WAIT_SECONDS} seconds for heavy Xray config startup..."
  sleep "$STARTUP_WAIT_SECONDS"
  show_status

  echo
  echo "[DONE] Patch applied."
  echo "This command is safe to run again if it was interrupted or failed halfway."
}

show_status() {
  require_root
  check_requirements

  echo
  echo "[INFO] Docker container:"
  docker ps --filter "name=${CONTAINER_NAME}" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" || true

  echo
  echo "[INFO] Compose mount state:"
  if compose_has_rest_service_mount; then
    grep "/code/rest_service.py" "$COMPOSE_FILE" || true
  else
    echo "No rest_service.py bind mount found."
  fi

  echo
  echo "[INFO] Host patch file:"
  if host_patch_file_is_valid; then
    echo "$PATCH_FILE is present and valid."
  else
    echo "$PATCH_FILE is missing or invalid."
  fi

  echo
  echo "[INFO] Xray process inside container:"
  docker exec "$CONTAINER_NAME" sh -c 'pgrep -a xray || true' || true

  echo
  echo "[INFO] Listening ports inside container:"
  docker exec "$CONTAINER_NAME" sh -c "ss -tulpen 2>/dev/null | grep -E 'xray|62050|62051' || true" || true

  echo
  echo "[INFO] Recent logs:"
  docker logs --tail=80 "$CONTAINER_NAME" || true
}

restore_patch() {
  require_root
  check_os
  check_requirements
  backup_compose
  remove_bind_mount
  info "Recreating container without bind mount..."
  compose_up force
  echo
  echo "[DONE] Restore completed."
  echo "The compose bind mount was removed. Marzban Node should now use its original image file."
}

COMMAND="${1:-help}"

case "$COMMAND" in
  apply) apply_patch ;;
  status) show_status ;;
  restore) restore_patch ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
